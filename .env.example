# Copie para .env apenas no desenvolvimento; nunca versione o .env.
# No Render, configure APP_ENV=production e os segredos no painel.
APP_ENV=development
FLASK_DEBUG=0

# Obrigatória: gere um segredo aleatório e preencha somente no .env local.
SECRET_KEY=

# Vazio permite SQLite apenas no desenvolvimento.
# Em produção, configure a conexão PostgreSQL do Session Pooler no painel.
DATABASE_URL=

# Opcionais: bootstrap apenas quando a base não possui usuários.
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Opcional: diretório de XMLs apenas no desenvolvimento.
# Vazio usa uploads/nfes; em produção o arquivamento está desativado.
XML_STORAGE_DIR=
