# Obrigatória em todos os ambientes. Use uma chave longa e aleatória.
SECRET_KEY=<gere-uma-chave-longa-e-aleatoria>

# Produção (Render + Supabase): preencha somente no painel do provedor.
DATABASE_URL=postgresql+psycopg://USUARIO:SENHA@HOST:5432/BANCO?sslmode=require

# Opcional: somente no primeiro início de uma base vazia (SQLite ou PostgreSQL).
# Remova estas variáveis depois de criar o administrador inicial.
BOOTSTRAP_ADMIN_NAME=Administrador
BOOTSTRAP_ADMIN_EMAIL=admin@exemplo.com
BOOTSTRAP_ADMIN_PASSWORD=<defina-uma-senha-segura>

# Opcional: diretório persistente dos XMLs. Sem esta variável, usa uploads/nfes localmente.
XML_STORAGE_DIR=/caminho/para/armazenamento-persistente/nfes
